{
  "pest it": {
    "prefix": "it",
    "body": [
      "it(\"$1\", function () {",
      "\t$0",
      "});"
    ],
    "description": "PestPHP it block"
  },
  "pest it validates": {
    "prefix": "itv",
    "body": [
      "it('validates the data', function (\\$attribute, \\$value, \\$message) {",
      "\tfactory([",
      "\t\t\\$attribute => \\$value",
      "\t])->assertInvalid([",
      "\t\t\\$attribute => \\$message",
      "\t]);",
      "})->with([",
      "\t'${1:name} is required' => ['$1', null, 'The $1 field is required.'],",
      "]);"
    ],
    "description": "PestPHP it block"
  },
  "assertJson": {
    "prefix": "assertJson",
    "body": [
      "->assertJson(fn (AssertableJson \\$json) =>",
      "\t\\$json->$0->etc()",
      ");"
    ],
    "description": "Laravel assertJson with AssertableJson"
  },
  "feature test": {
    "prefix": "ftest",
    "body": [
      "it('has a valid factory', function () {",
      "\t${1:factory}(\\$this->humans);",
      "});",
      "",
      "function $1(Workspace \\$workspace, array \\$attributes = [])",
      "{",
      "\treturn test()->postJson(route('$2'), [",
      "\t\t...\\$attributes,",
      "\t]);",
      "}"
    ],
    "description": "Medley test template with factory function"
  },
  "channel feature test": {
    "prefix": "ctest",
    "body": [
      "beforeEach(function () {",
      "\t\\$this->channel = Channel::factory()->for(\\$this->humans)->create();",
      "});",
      "",
      "it('has a valid factory', function () {",
      "\t${1:factory}(\\$this->humans, \\$this->channel)->assertSuccessful();",
      "});",
      "",
      "$0",
      "",
      "function $1(Workspace \\$workspace, Channel \\$channel, array \\$attributes = [])",
      "{",
      "\treturn test()->postJson(route('app.channels.$2', [\\$workspace, \\$channel]), [",
      "\t\t...\\$attributes,",
      "\t]);",
      "}"
    ],
    "description": "Medley test template with factory function"
  },

  "space feature test": {
    "prefix": "stest",
    "body": [
      "beforeEach(function () {",
      "\t\\$this->channel = Channel::factory()->for(\\$this->humans)->create();",
      "\t\\$this->${1:todo} = ${2:Todo}::factory()->for(\\$this->humans)->for(\\$this->channel)->create();",
      "});",
      "",
      "it('has a valid factory', function () {",
      "\t${3:factory}(\\$this->humans, \\$this->channel, \\$this->$1)->assertSuccessful();",
      "});",
      "",
      "$0",
      "",
      "function $3(Workspace \\$workspace, Channel \\$channel, ${2:Todo} \\$$1, array \\$attributes = [])",
      "{",
      "\treturn test()->postJson(route('app.channels.$4', [\\$workspace, \\$channel, \\$$1]), [",
      "\t\t...\\$attributes,",
      "\t]);",
      "}"
    ],
    "description": "Medley test template with factory function"
  }
}
