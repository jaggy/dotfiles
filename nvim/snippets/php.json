      "\t\t\\$attribute => \\$message",
      "\t]);",
      "})->with([",
      "\t'${1:name} is required' => ['$1', null, 'The $1 field is required.'],",
      "]);"
    ],
    "description": "PestPHP it block"
  },
  "assertJson": {
